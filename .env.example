# LLM provider keys (never commit real values; copy to .env locally)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Anthropic 연결 주소
# - 코디세이 발급 키(sk-cody-...)는 코디세이 프록시를 거쳐야 동작 → 아래 주소 그대로 사용
# - Anthropic 콘솔 공식 키(sk-ant-...)를 쓰면 이 줄을 비워 두기
ANTHROPIC_BASE_URL=https://copa.codyssey.kr

DEFAULT_LLM_PROVIDER=openai
# 코디세이 프록시의 Claude 모델: claude-haiku-4 / claude-sonnet-4 / claude-opus-4-7 / claude-opus-4-8
# (예: DEFAULT_LLM_PROVIDER=anthropic, DEFAULT_LLM_MODEL=claude-sonnet-4)
DEFAULT_LLM_MODEL=

APP_ENV=development
